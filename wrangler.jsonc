// Cloudflare Workers 静态资产部署配置
// dist/ 由 `npm run build` 生成,wrangler deploy 时整包上传到 Worker,
// 已在 CF 面板绑定的自定义域名(含中文子域名)与路由不受影响。
// 未匹配到的路径返回 404(如需自定义 404 页,加 not_found_handling: "404-page" 并提供 dist/404.html)
{
  "name": "snow-plume",
  "compatibility_date": "2026-08-01",
  // 站点只走自定义域名(配合 IP 优选):关闭 workers.dev 镜像与版本预览 URL,
  // 避免出现绕过域名层配置的公开入口。如需临时调试,改回 true 再部署即可
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  }
}
