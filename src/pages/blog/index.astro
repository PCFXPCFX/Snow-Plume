<!--
  BlogArchive — 全部文章归档
  路由: /blog/
  按年份分组列出站内所有博客文章，风格与文章详情页一致
-->
---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const groupNameMap: Record<string, string> = {
  lovelive: "LoveLive! 综合",
  "缪": "μ's",
  "水": "Aqours",
  "虹": "虹咲学园",
  "星": "Liella!",
  "莲": "莲之空",
  "鸟": "人生不易部",
};

const formatDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, "0")}.${String(d.getDate()).padStart(2, "0")}`;

// 按年份分组，新的年份在前
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const yearEntries = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<Layout title={`全部文章 — LoveLive!`} description="LoveLive! 粉丝站全部博客文章归档">
  <article class="max-w-3xl mx-auto px-6 py-20">
    <!-- 返回链接 -->
    <a
      href="/"
      data-back-to-hub
      class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-gray-600 transition-colors mb-10 group"
    >
      <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
      </svg>
      返回
    </a>

    <!-- 页面头部：与文章详情页同构 -->
    <header class="mb-16">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-500 mb-5 tracking-wide">
        ARCHIVE
      </span>
      <h1 class="text-3xl md:text-4xl font-black text-gray-900 mb-4 leading-tight tracking-tight">
        全部文章
      </h1>
      <div class="flex items-center gap-3">
        <div class="w-8 h-0.5 rounded-full" style="background: var(--accent, #ec4899)"></div>
        <span class="text-sm text-gray-400 tracking-wide">共 {posts.length} 篇</span>
      </div>
    </header>

    <!-- 按年份分组的文章列表 -->
    {yearEntries.map(([year, yearPosts]) => (
      <section class="mb-14 last:mb-0">
        <h2 class="text-xs tracking-[0.3em] text-gray-400 font-bold mb-2">{year}</h2>
        <ul class="divide-y divide-gray-100">
          {yearPosts.map((post) => (
            <li>
              <a
                href={`/blog/${post.slug}/`}
                class="group flex items-center justify-between gap-6 py-5"
              >
                <div class="flex-1 min-w-0">
                  <h3 class="text-base md:text-lg font-semibold text-gray-800 group-hover:text-gray-900 transition-colors leading-snug">
                    {post.data.title}
                  </h3>
                  {post.data.excerpt && (
                    <p class="mt-1.5 text-sm text-gray-400 line-clamp-1 leading-relaxed">
                      {post.data.excerpt}
                    </p>
                  )}
                  <div class="mt-2.5 flex items-center gap-3 text-xs text-gray-400 tracking-wide">
                    <time datetime={post.data.date.toISOString()} class="tabular-nums">
                      {formatDate(post.data.date)}
                    </time>
                    <span class="w-1 h-1 rounded-full bg-gray-200"></span>
                    <span>{groupNameMap[post.data.group] || post.data.group}</span>
                  </div>
                </div>
                <!-- 右侧箭头 -->
                <span class="text-gray-200 group-hover:text-gray-400 transition-all duration-300 shrink-0 group-hover:translate-x-0.5">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <!-- 底部导航 -->
    <footer class="mt-20 pt-8 border-t border-gray-100 flex justify-between items-center">
      <a
        href="/"
        data-back-to-hub
        class="text-sm text-gray-400 hover:text-gray-600 transition-colors flex items-center gap-1.5 group"
      >
        <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
        </svg>
        返回主页
      </a>
      <span class="text-xs text-gray-300">LoveLive! 粉丝站</span>
    </footer>
  </article>
</Layout>
